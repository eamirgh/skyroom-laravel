{
    "name": "eamirgh/skyroom-laravel",
    "description": "Production-ready Laravel wrapper for Skyroom API",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Amir Ghaffari",
            "email": "a.g.h.94.72@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.3",
        "laravel/pint": "^1.32"
    },
    "autoload": {
        "psr-4": {
            "Skyroom\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Skyroom\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Skyroom\\Laravel\\SkyroomServiceProvider"
            ],
            "aliases": {
                "Skyroom": "Skyroom\\Laravel\\Facades\\Skyroom"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "format-test": "vendor/bin/pint --test"
    },
    "config": {
        "audit": {
            "block-insecure": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
